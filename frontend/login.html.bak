<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign In - CBC School ERP</title>
<script src="/js/config.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:linear-gradient(135deg,#1e1b4b 0%,#312e81 50%,#4338ca 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.card{background:#fff;border-radius:24px;padding:44px 40px;width:100%;max-width:440px;box-shadow:0 25px 60px rgba(0,0,0,.3)}
.logo{text-align:center;margin-bottom:28px}
.logo-icon{width:56px;height:56px;background:linear-gradient(135deg,#4f46e5,#7c3aed);border-radius:16px;display:inline-flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:12px;color:#fff;font-weight:800}
.logo h1{font-size:24px;font-weight:800;color:#0f172a}
.logo p{font-size:13px;color:#64748b;margin-top:4px;font-weight:500}
.fg{margin-bottom:16px}
.fg label{display:block;font-size:11.5px;font-weight:700;color:#64748b;margin-bottom:6px;text-transform:uppercase;letter-spacing:.04em}
.fg input{width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:14px;color:#0f172a;font-family:inherit;outline:none;transition:border-color .15s,box-shadow .15s;background:#fff}
.fg input:focus{border-color:#4f46e5;box-shadow:0 0 0 3px rgba(79,70,229,.12)}
.fg input::placeholder{color:#cbd5e1}
.hint{font-size:12px;color:#94a3b8;margin:-8px 0 14px 2px}
.hint strong{color:#64748b}
.btn-submit{width:100%;padding:14px;background:linear-gradient(135deg,#4f46e5,#7c3aed);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .2s;position:relative;margin-top:4px}
.btn-submit:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(79,70,229,.35)}
.btn-submit:disabled{opacity:.7;cursor:not-allowed;transform:none}
.alert{padding:12px 16px;border-radius:10px;font-size:13.5px;margin-top:14px;font-weight:500;display:none}
.alert.show{display:block}
.alert-err{background:#fee2e2;color:#b91c1c;border:1px solid #fecaca}
.alert-ok{background:#dcfce7;color:#166534;border:1px solid #bbf7d0}
.footer{text-align:center;margin-top:24px;font-size:12px;color:#94a3b8}
</style>
</head>
<body>
<div class="card">
  <div class="logo">
    <div class="logo-icon">ERP</div>
    <h1>CBC School ERP</h1>
    <p>Kenya Competency Based Curriculum</p>
  </div>

  <form id="loginForm">
    <div class="fg">
      <label>School Code</label>
      <input id="school_code" type="text" placeholder="e.g. KPRI001" autocomplete="organization" maxlength="20" style="text-transform:uppercase">
    </div>
    <p class="hint">Enter the school code issued by your administrator.</p>

    <div class="fg">
      <label>Username or Email</label>
      <input id="username" type="text" placeholder="username or email" autocomplete="username">
    </div>
    <div class="fg">
      <label>Password</label>
      <input id="password" type="password" placeholder="Password" autocomplete="current-password">
    </div>

    <div class="alert" id="message"></div>
    <button class="btn-submit" id="loginBtn" type="submit">Sign In</button>
  </form>

  <div class="footer">CBC School ERP v5.3 - Powered by ZETU Business Solutions</div>
</div>

<script type="module" src="/js/login.js"></script>
</body>
</html>
