# ── Kadem & Zetu School Management System — Environment Variables ──────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/cbc_erp

# ── JWT (min 32 chars, use: openssl rand -hex 32) ────────────────────────────
JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters
JWT_EXPIRES=10h

# ── CORS (comma-separated frontend origins) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5500

# ── Paystack (live keys from dashboard.paystack.com) ─────────────────────────
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_LIVE_KEY_HERE
PAYSTACK_CALLBACK_URL=https://your-frontend-domain/subscription.html

# ── Pesapal (live keys from business.pesapal.com) ────────────────────────────
PESAPAL_BASE_URL=https://pay.pesapal.com/v3/api
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_URL=https://your-api-domain.onrender.com/api/subscriptions/ipn
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=https://your-frontend-domain/subscription.html

# ── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_MODEL=llama3-8b-8192
