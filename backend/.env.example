# Database
DATABASE_URL=postgresql://user:password@host:5432/cbc_erp

# JWT
JWT_SECRET=replace_with_64_char_random_string_here
JWT_EXPIRES=10h

# Server
PORT=5000
NODE_ENV=development

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-school-domain.com

# Pesapal subscriptions (LIVE)
# Sandbox URL: https://cybqa.pesapal.com/pesapalv3/api
# Live URL:    https://pay.pesapal.com/v3/api
PESAPAL_BASE_URL=https://pay.pesapal.com/v3/api
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_CALLBACK_URL=https://cbc-school-erp.pages.dev/subscription.html
PESAPAL_IPN_URL=https://cbc-school-erp-api.onrender.com/api/subscriptions/ipn
# Optional: set this after registering an IPN once to avoid re-registering on every restart
PESAPAL_IPN_ID=

# Paystack (LIVE)
# Use sk_live_... for production. sk_test_... is test mode only.
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_CALLBACK_URL=https://cbc-school-erp.pages.dev/subscription.html
