# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/cbc_erp

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string_here
JWT_EXPIRES=10h

# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CORS (comma-separated) ───────────────────────────────────────
ALLOWED_ORIGINS=https://your-school-domain.com,https://www.your-school-domain.com
