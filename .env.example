# ZETU School Management System - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Node Environment
NODE_ENV=production

# Server
PORT=5000
HOST=0.0.0.0

# Database
DB_HOST=your-postgres-host.com
DB_PORT=5432
DB_NAME=school_management
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=your-very-long-and-secure-secret-key-at-least-64-characters-long
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-key
JWT_REFRESH_EXPIRY=30d

# CORS Configuration
CORS_ORIGIN=https://your-frontend-domain.com,https://another-domain.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@zetusms.com

# File Storage (S3 or similar)
STORAGE_TYPE=s3
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/zetu-sms/app.log

# Monitoring & Analytics
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=true

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# API Configuration
REACT_APP_API_BASE_URL=https://api.zetusms.com/api
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY=3

# Application
REACT_APP_NAME=ZETU School Management System
REACT_APP_VERSION=1.0.0

# Features
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_REPORTS=true
REACT_APP_ENABLE_EXPORT=true

# Security
REACT_APP_ENABLE_CORS=true
REACT_APP_ENABLE_CSP=true
REACT_APP_SESSION_TIMEOUT=1800000
REACT_APP_TOKEN_REFRESH=3600000

# Logging
REACT_APP_LOG_LEVEL=error

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================

# M-Pesa Integration
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_ENVIRONMENT=sandbox

# SMS Gateway (for notifications)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# SECURITY & COMPLIANCE
# ============================================

# Data Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars
ENCRYPTION_ALGORITHM=aes-256-gcm

# Audit Logging
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=365

# ============================================
# DEPLOYMENT
# ============================================

# Render.com Configuration
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxx

# GitHub Integration
GITHUB_TOKEN=your-github-token
GITHUB_REPO=your-username/school-management-system

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false

# Mock Data
USE_MOCK_DATA=false
MOCK_DATA_SEED=12345
