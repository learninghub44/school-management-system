# CBC School ERP environment
# Copy to backend/.env for local backend development.

DATABASE_URL=postgresql://user:password@host:5432/cbc_erp
JWT_SECRET=replace_with_at_least_32_characters_prefer_64_or_more
JWT_EXPIRES=10h

# Local backend default. Render may override this to 3000 through render.yaml.
PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-school-domain.com

# Groq OpenAI-compatible AI
GROQ_API_KEY=replace_with_groq_key
GROQ_MODEL=openai/gpt-oss-20b

# Pesapal API 3.0 (LIVE)
# Sandbox: https://cybqa.pesapal.com/pesapalv3/api
# Live:    https://pay.pesapal.com/v3/api
PESAPAL_BASE_URL=https://pay.pesapal.com/v3/api
PESAPAL_CONSUMER_KEY=replace_with_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=replace_with_pesapal_consumer_secret
PESAPAL_CALLBACK_URL=https://cbc-school-erp.pages.dev/subscription.html
PESAPAL_IPN_URL=https://cbc-school-erp-api.onrender.com/api/subscriptions/ipn
# Optional: set after registering an IPN once to avoid registering on every checkout.
PESAPAL_IPN_ID=

# Paystack (LIVE)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_CALLBACK_URL=https://cbc-school-erp.pages.dev/subscription.html
